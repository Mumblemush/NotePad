<?xml version="1.0" encoding="utf-8"?>
<!-- 功能I：编辑页重做
     原来的结构是「顶栏标题 + 一行文件夹提示 + 带蓝色横线的编辑区」，
     现在改成：自绘顶栏（返回 / 更多）→ 标题 + 一行元信息 → 白纸正文 → 底部格式工具栏。
     正文不再是 LinedEditText，横线是原版扫盲用的装饰，画出来的线和文字基线对不齐，
     而且颜色比正文还抢眼，所以整块去掉，靠行距和留白来分行。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 顶栏：左边返回，右边更多。纯文字图标，不依赖图片资源 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="←"
            android:textColor="#333333"
            android:textSize="24sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left|center_vertical"
            android:paddingLeft="4dp"
            android:text="笔记"
            android:textColor="#1F1F1F"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_more"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#333333"
            android:textSize="22sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8" />

    <!-- 标题区：标题是正文上方的一个大字，空的时侯显示灰色「标题」占位；
         下面一行是元信息：创建时间 ｜ 字数，右边是所在文件夹，点它可以换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="标题"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#1F1F1F"
            android:textColorHint="#C2C5CA"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_note_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_note_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="｜ 未分类 ▾"
                android:textColor="#7B8FA6"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 正文：一张白纸。左右各 20dp 留白，行距 1.5 左右，靠留白区分行，不画线 -->
    <EditText
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:gravity="top|left"
        android:paddingLeft="20dp"
        android:paddingTop="6dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        android:textSize="18sp"
        android:textColor="#333333"
        android:lineSpacingExtra="9dp"
        android:capitalize="sentences" />

    <!-- 功能F：格式工具栏。
         放在编辑区下方，不跟系统的"长按选中→复制/粘贴"浮动菜单抢位置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FAFAFA"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btn_bold"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/fmt_btn_bg"
            android:gravity="center"
            android:text="B"
            android:textColor="#333333"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_italic"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/fmt_btn_bg"
            android:gravity="center"
            android:text="I"
            android:textColor="#333333"
            android:textSize="19sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/btn_size_down"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/fmt_btn_bg"
            android:gravity="center"
            android:text="A-"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_size_up"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/fmt_btn_bg"
            android:gravity="center"
            android:text="A+"
            android:textColor="#333333"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_color"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/fmt_btn_bg"
            android:gravity="center"
            android:text="颜色"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_image"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/fmt_btn_bg"
            android:gravity="center"
            android:text="图片"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_bg"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/fmt_btn_bg"
            android:gravity="center"
            android:text="背景"
            android:textColor="#333333"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
