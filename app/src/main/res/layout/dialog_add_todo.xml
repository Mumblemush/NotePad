<?xml version="1.0" encoding="utf-8"?>
<!-- 新建待办 / 日历添加待办 共用的对话框内容 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/et_todo_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="要做什么？"
        android:inputType="text"
        android:maxLines="2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="优先级"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/priority_high"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:background="@color/priority_high"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="紧急"
            android:textColor="#5D1010"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/priority_normal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:background="@color/priority_normal"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="一般"
            android:textColor="#5D4A00"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/priority_low"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/priority_low"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="不急"
            android:textColor="#0D3B5C"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_todo_due_pick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="截止：未设置（点这里选日期和时间）"
        android:textColor="@color/app_primary"
        android:textSize="14sp" />

</LinearLayout>
